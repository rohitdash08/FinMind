[34.223146, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[35.496651, "o", "\u001b[1m\u001b[96m  7. List all shared expenses\u001b[0m\r\n"]
[35.496651, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[35.496651, "o", "\r\n"]
[36.128357, "o", "\u001b[92m$ GET /shared-budgets/1/expenses\u001b[0m\r\n"]
[36.758005, "o", "  \u001b[92m200 OK\u001b[0m - 3 expenses:\r\n"]
[37.997615, "o", "    \u001b[2mUser 1: $   1250.50  Weekly groceries from market\u001b[0m\r\n"]
