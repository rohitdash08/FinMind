[40.852564, "o", "\r\n"]
[40.852564, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[41.915622, "o", "\u001b[1m\u001b[96m  8. Permission checks\u001b[0m\r\n"]
[41.915622, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[41.915622, "o", "\r\n"]
[43.127425, "o", "\u001b[92m$ DELETE /shared-budgets/{budget_id} - Bob tries to delete (not owner)\u001b[0m\r\n"]
[44.133071, "o", "  \u001b[93m403 Forbidden\u001b[0m - Only owner can delete\r\n"]
[44.133071, "o", "  \u001b[97m{\u001b[0m\r\n"]
[44.133071, "o", "  \u001b[97m  \"error\": \"only the owner can delete\"\u001b[0m\r\n"]
[44.133071, "o", "  \u001b[97m}\u001b[0m\r\n"]
[44.765033, "o", "\u001b[92m$ POST /shared-budgets (no auth)\u001b[0m\r\n"]
[46.1379, "o", "  \u001b[93m401 Unauthorized\u001b[0m - Auth required\r\n"]
[46.1379, "o", "\r\n"]
