[28.928222, "o", "  \u001b[97m      \"user_id\": 1\u001b[0m\r\n"]
[28.928222, "o", "  \u001b[97m    },\u001b[0m\r\n"]
[28.928222, "o", "  \u001b[97m    {\u001b[0m\r\n"]
