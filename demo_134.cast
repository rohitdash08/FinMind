[1.526646, "o", "\r\n"]
[1.526646, "o", "\u001b[1m\u001b[93m\r\n"]
[1.526646, "o", "  FinMind - Shared Household Budgeting Demo\r\n"]
[1.526646, "o", "  Issue #134 | Shared Budget Management\u001b[0m\r\n"]
[1.526646, "o", "\u001b[2m  Feature: /shared-budgets - Collaborative Family Budgeting\u001b[0m\r\n"]
[1.526646, "o", "\r\n"]
[1.526646, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[2.909312, "o", "\u001b[1m\u001b[96m  1. Setting up test environment\u001b[0m\r\n"]
[2.909312, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[2.909312, "o", "\r\n"]
[4.027428, "o", "  \u001b[92m[OK]\u001b[0m Flask app created with in-memory SQLite\r\n"]
[5.318885, "o", "  \u001b[92m[OK]\u001b[0m Database tables created\r\n"]
[5.318885, "o", "\r\n"]
[5.318885, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[6.654195, "o", "\u001b[1m\u001b[96m  2. Register household members\u001b[0m\r\n"]
[6.654195, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[6.654195, "o", "\r\n"]
[7.643633, "o", "\u001b[92m$ POST /auth/register - Alice (household owner)\u001b[0m\r\n"]
[8.720957, "o", "  \u001b[92m201 Created\u001b[0m - Alice registered & logged in\r\n"]
[9.703835, "o", "\u001b[92m$ POST /auth/register - Bob (household member)\u001b[0m\r\n"]
[11.238961, "o", "  \u001b[92m201 Created\u001b[0m - Bob registered & logged in\r\n"]
[11.238961, "o", "\r\n"]
[11.238961, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[12.755336, "o", "\u001b[1m\u001b[96m  3. Create a shared household budget\u001b[0m\r\n"]
[12.755336, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[12.755336, "o", "\r\n"]
[13.230943, "o", "\u001b[92m$ POST /shared-budgets\u001b[0m\r\n"]
[14.933104, "o", "  \u001b[92m201 Created\u001b[0m - Budget 'Family Groceries' (id=1)\r\n"]
[14.933104, "o", "  \u001b[97m{\u001b[0m\r\n"]
[14.933104, "o", "  \u001b[97m  \"id\": 1,\u001b[0m\r\n"]
[14.933104, "o", "  \u001b[97m  \"name\": \"Family Groceries\"\u001b[0m\r\n"]
[14.933104, "o", "  \u001b[97m}\u001b[0m\r\n"]
[14.933104, "o", "\r\n"]
[14.933104, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[16.206563, "o", "\u001b[1m\u001b[96m  4. Invite Bob to the budget\u001b[0m\r\n"]
[16.206563, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[16.206563, "o", "\r\n"]
[16.838382, "o", "\u001b[92m$ POST /shared-budgets/1/members\u001b[0m\r\n"]
[18.28361, "o", "  \u001b[92m201 Created\u001b[0m - Bob added as member\r\n"]
[18.28361, "o", "  \u001b[97m{\u001b[0m\r\n"]
[18.28361, "o", "  \u001b[97m  \"id\": 2,\u001b[0m\r\n"]
[18.28361, "o", "  \u001b[97m  \"role\": \"member\",\u001b[0m\r\n"]
[18.28361, "o", "  \u001b[97m  \"user_id\": 2\u001b[0m\r\n"]
[18.28361, "o", "  \u001b[97m}\u001b[0m\r\n"]
[18.28361, "o", "\r\n"]
[18.28361, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[19.465704, "o", "\u001b[1m\u001b[96m  5. Track shared expenses\u001b[0m\r\n"]
[19.465704, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[19.465704, "o", "\r\n"]
[20.45044, "o", "\u001b[92m$ POST /shared-budgets/1/expenses - Alice's groceries\u001b[0m\r\n"]
[21.447289, "o", "  \u001b[92m201 Created\u001b[0m - Alice spent $1,250.50\r\n"]
[21.447289, "o", "  \u001b[97m{\u001b[0m\r\n"]
[21.447289, "o", "  \u001b[97m  \"amount\": 1250.5,\u001b[0m\r\n"]
[21.447289, "o", "  \u001b[97m  \"date\": \"2026-03-06\",\u001b[0m\r\n"]
[21.447289, "o", "  \u001b[97m  \"description\": \"Weekly groceries from market\",\u001b[0m\r\n"]
[21.447289, "o", "  \u001b[97m  \"id\": 1\u001b[0m\r\n"]
[21.447289, "o", "  \u001b[97m}\u001b[0m\r\n"]
[22.367832, "o", "\u001b[92m$ POST /shared-budgets/1/expenses - Bob's groceries\u001b[0m\r\n"]
[23.28022, "o", "  \u001b[92m201 Created\u001b[0m - Bob spent $800.00\r\n"]
[23.28022, "o", "  \u001b[97m{\u001b[0m\r\n"]
[23.28022, "o", "  \u001b[97m  \"amount\": 800.0,\u001b[0m\r\n"]
