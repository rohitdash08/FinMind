[30.125443, "o", "  \u001b[2m  Attempt 6: \u001b[91m401 Invalid credentials\u001b[0m\r\n"]
[30.125443, "o", "\r\n"]
[31.626586, "o", "  \u001b[91m[ALERT] Brute force detected!\u001b[0m 5+ failed attempts in 15 minutes\r\n"]
[32.639063, "o", "\u001b[92m$ GET /security/anomalies (checking for brute_force flag)\u001b[0m\r\n"]
[34.046256, "o", "  \u001b[91mFound 1 brute force event(s)\u001b[0m\r\n"]
