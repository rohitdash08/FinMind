[1.595318, "o", "\r\n"]
[1.595318, "o", "\u001b[1m\u001b[93m\r\n"]
[1.595318, "o", "  FinMind - Login Anomaly Detection Demo\r\n"]
[1.595318, "o", "  Issue #124 | Security & Suspicious Activity Alerts\u001b[0m\r\n"]
[1.595318, "o", "\u001b[2m  Feature: /security - Login monitoring & anomaly detection\u001b[0m\r\n"]
[1.595318, "o", "\r\n"]
[1.595318, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[2.98064, "o", "\u001b[1m\u001b[96m  1. Setting up test environment\u001b[0m\r\n"]
[2.98064, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[2.98064, "o", "\r\n"]
[4.098284, "o", "  \u001b[92m[OK]\u001b[0m Flask app created with in-memory SQLite\r\n"]
[5.819333, "o", "  \u001b[92m[OK]\u001b[0m Database tables created (login_events table)\r\n"]
[5.819333, "o", "\r\n"]
[5.819333, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[7.545432, "o", "\u001b[1m\u001b[96m  2. First Login - New IP & Device Detection\u001b[0m\r\n"]
[7.545432, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[7.545432, "o", "\r\n"]
[8.070039, "o", "\u001b[92m$ POST /auth/register\u001b[0m\r\n"]
[8.882488, "o", "  \u001b[92m201 Created\u001b[0m - User registered\r\n"]
[9.868831, "o", "\u001b[92m$ POST /auth/login (first login from new IP/device)\u001b[0m\r\n"]
[10.598008, "o", "  \u001b[92m200 OK\u001b[0m - Login successful\r\n"]
[12.376884, "o", "  \u001b[93m[ALERT]\u001b[0m New IP and new device detected (first login)\r\n"]
[12.376884, "o", "\r\n"]
[12.376884, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[13.466588, "o", "\u001b[1m\u001b[96m  3. View Login History\u001b[0m\r\n"]
[13.466588, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[13.466588, "o", "\r\n"]
[14.05265, "o", "\u001b[92m$ GET /security/login-history\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[92m200 OK\u001b[0m - 1 login event(s):\r\n"]
[15.469462, "o", "  \u001b[97m{\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m  \"events\": [\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m    {\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m      \"anomaly_reasons\": [\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m        \"new_ip\",\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m        \"new_device\"\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m      ],\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m      \"anomaly_score\": 0.6,\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m      \"id\": 1,\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m      \"ip_address\": \"127.0.0.1\",\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m      \"login_at\": \"2026-03-06T11:03:40.093117\",\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m      \"success\": true,\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m      \"user_agent\": \"Werkzeug/3.1.6\"\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m    }\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m  ]\u001b[0m\r\n"]
[15.469462, "o", "  \u001b[97m}\u001b[0m\r\n"]
[15.469462, "o", "\r\n"]
[15.469462, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[17.043481, "o", "\u001b[1m\u001b[96m  4. View Anomalies (Suspicious Logins)\u001b[0m\r\n"]
[17.043481, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[17.043481, "o", "\r\n"]
[17.564615, "o", "\u001b[92m$ GET /security/anomalies\u001b[0m\r\n"]
[18.396324, "o", "  \u001b[92m200 OK\u001b[0m - 1 anomalous event(s):\r\n"]
[19.971021, "o", "    \u001b[91mScore: 0.6\u001b[0m | Reasons: new_ip, new_device\r\n"]
[19.971021, "o", "\r\n"]
[19.971021, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[21.544756, "o", "\u001b[1m\u001b[96m  5. Repeat Login - No Anomaly Expected\u001b[0m\r\n"]
[21.544756, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[21.544756, "o", "\r\n"]
[22.409317, "o", "\u001b[92m$ POST /auth/login (same IP, same device)\u001b[0m\r\n"]
[23.140242, "o", "  \u001b[92m200 OK\u001b[0m - Login successful\r\n"]
[24.716453, "o", "  \u001b[92m[OK]\u001b[0m No anomaly - recognized IP and device\r\n"]
[24.716453, "o", "\r\n"]
[24.716453, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[25.898862, "o", "\u001b[1m\u001b[96m  6. Brute Force Detection\u001b[0m\r\n"]
[25.898862, "o", "\u001b[1m\u001b[96m============================================================\u001b[0m\r\n"]
[25.898862, "o", "\r\n"]
[26.691511, "o", "\u001b[92m$ Simulating 6 failed login attempts...\u001b[0m\r\n"]
[27.267744, "o", "  \u001b[2m  Attempt 1: \u001b[91m401 Invalid credentials\u001b[0m\r\n"]
[27.845622, "o", "  \u001b[2m  Attempt 2: \u001b[91m401 Invalid credentials\u001b[0m\r\n"]
[28.428139, "o", "  \u001b[2m  Attempt 3: \u001b[91m401 Invalid credentials\u001b[0m\r\n"]
[29.016835, "o", "  \u001b[2m  Attempt 4: \u001b[91m401 Invalid credentials\u001b[0m\r\n"]
