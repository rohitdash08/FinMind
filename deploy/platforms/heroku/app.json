{
  "name": "FinMind",
  "description": "Personal Finance Management Platform",
  "repository": "https://github.com/rohitdash08/FinMind",
  "keywords": ["finance", "budgeting", "python", "flask"],
  "addons": [
    { "plan": "heroku-postgresql:mini" },
    { "plan": "heroku-redis:mini" }
  ],
  "env": {
    "JWT_SECRET": { "generator": "secret" },
    "LOG_LEVEL": { "value": "INFO" },
    "GEMINI_MODEL": { "value": "gemini-1.5-flash" }
  },
  "buildpacks": [
    { "url": "heroku/python" }
  ],
  "scripts": {
    "postdeploy": "python -m flask --app wsgi:app init-db"
  }
}
